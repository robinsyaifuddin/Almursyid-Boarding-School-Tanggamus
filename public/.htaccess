<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Routing API ke backend
  RewriteRule ^api/(.*)$ backend/endpoints/$1 [QSA,L]

  # 2. Jangan rewrite jika file statis memang ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback SPA React ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /index.html
