<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Routing khusus API: arahkan /api/* ke handler jembatan
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Jangan rewrite jika file statis (JS, CSS, gambar) memang ada di public_html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback seluruh rute Frontend SPA React ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /index.html
